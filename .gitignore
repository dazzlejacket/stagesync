# --- Recordings and generated media (never commit) ---
#
# The rules below are anchored to the root of the repository. An unanchored
# "audio/" also matched crates/stagesync-core/src/audio/, which is the source
# of the decoder and the WAV writer — a fresh clone could not compile.
/audio/
*.wav
*.m4a
*.mp4
*.mp3
*.flac
*.aiff
*.aif
*.caf
*.ogg
!crates/**/testdata/**/*.wav

# --- Build output ---
/target/
**/target/
*.exe
*.dll
*.pdb
*.rlib
*.rmeta

# --- StageSync working artefacts ---
/out/
/exports/
/work/
/artifacts/
/testdata/
/dist/
*.corrected.wav
syncmap.csv
segments.csv
report.json
plan.json
timeline.txt
drift_graph.png
drift_graph.svg
*.pdf

# --- Caches ---
/.cache/
.cache/
**/.cache/
*.log

# --- Credentials / local config ---
.env
.env.*
*.secret
credentials.json
secrets.toml
.claude/
.mavis/

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Python analysis scratch ---
__pycache__/
*.pyc
.venv/
